Windows Registry Editor Version 5.00

; UU远程 URL 协议注册
; 调用 batch 包装脚本

[HKEY_CLASSES_ROOT\uuycmgr]
@="URL:UU远程控制协议"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\uuycmgr\DefaultIcon]
@="C:\\Program Files\\Netease\\GameViewer\\bin\\uuycmgr.exe,0"

[HKEY_CLASSES_ROOT\uuycmgr\shell]

[HKEY_CLASSES_ROOT\uuycmgr\shell\open]

[HKEY_CLASSES_ROOT\uuycmgr\shell\open\command]
@="\"D:\\uuycmgr_wrapper.bat\" \"%1\""
